# ================================================================
# VJVision 2.0 (C++ rewrite)
# ================================================================

# --- CMake build directories ---
build/
build_oss/
VJVision_build/
out/
cmake-build-*/

# --- Qt auto-generated files ---
**/moc_*.cpp
**/qrc_*.cpp
**/ui_*.h
**/.qt/
**/VJVision_autogen/

# --- Compiled binaries ---
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp

# --- Python (v1 legacy) ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.spec.bak
*.egg-info/

# --- Runtime / generated data ---
.cache/
data/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db-journal
*.obj
*.zip

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Temp / OS ---
tmp/
*.tmp
.DS_Store
Thumbs.db

# --- vcpkg ---
vcpkg_installed/

# --- Build artifacts (windeployqt + Release bundles) ---
deploy/
release/
test/
installer_output/

# --- Trae IDE workspace (local) ---
.trae/

# --- Proprietary / closed-source material (never publish) ---
# Local-only source trees and internal design documents live below this path.
# It is auto-linked by CMake when present; public clones build the open engine.
/proprietary/

# --- Local rollback backups (not part of the project) ---
/backup/
